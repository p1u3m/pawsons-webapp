# Supabase Auth Environment Variables
# Copy this file to .env.local and fill in your values

# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe server configuration. Use a key from the selected sandbox.
# Keep actual values in .env.local; never commit them.
STRIPE_MODE=sandbox
STRIPE_API_KEY=
# Add this only after creating the webhook endpoint:
STRIPE_WEBHOOK_SECRET=

# Separate signing secret for the sandbox-only webhook probe.
STRIPE_DEMO_WEBHOOK_SECRET=
